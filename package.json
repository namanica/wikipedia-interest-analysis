{
  "name": "wikipedia-interest-analysis",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://github.com/namanica/wikipedia-interest-analysis",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#lib/*": "./lib/*",
    "#package.json": "./package.json",
    "#test/*": "./test/*"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "validate:skill": "uvx --from skills-ref==0.1.1 agentskills validate \"$PWD\"",
    "test": "node --test \"test/**/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "pdfkit": "^0.20.2",
    "svg-to-pdfkit": "^0.1.8",
    "vega": "^6.4.0",
    "vega-lite": "^6.4.3"
  }
}
